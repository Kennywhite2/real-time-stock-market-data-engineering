# Copy to .env, fill locally, and NEVER commit .env
# Rotate any credentials previously stored in scripts or pasted into chats.
FINNHUB_API_KEY=REPLACE_WITH_NEW_FINNHUB_KEY

# Python producer/consumer running on Windows host
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=stock-quotes
S3_ENDPOINT_URL=http://localhost:9002
S3_BUCKET=bronze-transactions
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_NEW_S3_SECRET

# Snowflake account identifier, not full URL
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=REPLACE_WITH_NEW_SNOWFLAKE_PASSWORD
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DB=STOCKS_DBM
SNOWFLAKE_SCHEMA=COMMON
SNOWFLAKE_ROLE=

# Use strong URL-safe password for demonstration PostgreSQL connection string
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_URL_SAFE_PASSWORD
AIRFLOW_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
